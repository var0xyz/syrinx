# Local deploy target for deploy-openobserve-pi.sh (not committed with real hosts).
# Copy to deploy.env or let the script create it after the first interactive run.
#
# Examples:
#   DEPLOY_HOST=pi@10.0.0.50
#   DEPLOY_HOST=10.0.0.50          # uses SSH_USER (default: your local login name)
#   SSH_USER=pi                    # optional; only used when DEPLOY_HOST has no user@
