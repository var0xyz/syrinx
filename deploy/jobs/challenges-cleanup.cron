# Deletes expired recovery claim challenges every hour.
# Installed by deploy/scripts/syrinx/setup.sh into /etc/cron.d/<APP_NAME>-challenges-cleanup,
# with @APP_NAME@/@ENV_FILE@/@JOB_LOG_DIR@ substituted the same way as
# ripples-cleanup.cron (see that file for why `set -a` is needed).
0 * * * * @APP_USER@ set -a; . @ENV_FILE@; set +a; /usr/local/bin/@APP_NAME@-challenges-cleanup >> @JOB_LOG_DIR@/challenges-cleanup.log 2>&1
