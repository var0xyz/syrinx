{
  "name": "syrinx-spa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:signing": "node scripts/test-signing.mjs",
    "test:verify-binary": "node scripts/test-verify-binary.mjs",
    "test:reed-markdown": "node --experimental-strip-types scripts/test-reed-markdown.mjs",
    "test:identicon": "node --experimental-strip-types scripts/test-identicon.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "8.8.1",
    "@typescript-eslint/parser": "8.8.1",
    "@vite-pwa/sveltekit": "^0.5.0",
    "baseline-browser-mapping": "^2.11.12",
    "eslint": "9.13.0",
    "eslint-plugin-svelte": "^2.46.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "overrides": {
    "baseline-browser-mapping": "$baseline-browser-mapping"
  },
  "dependencies": {
    "openpgp": "^6.3.1",
    "qrcode-generator": "^2.0.4",
    "uuid": "^11.1.1"
  }
}
