# Database Configuration
export DB_HOST="localhost"
export DB_PORT="5432"
export DB_USER="syrinx"
export DB_PASSWORD="syrinx"
export DB_NAME="syrinx"
export DB_SSLMODE="disable"

# Server Configuration
export SERVER_NAME=""  # Your server name
export PORT=8080  # The port the backend will listen on
export ALLOWED_ORIGIN="http://localhost:5173"  # The URL of your frontend

# On first interactive start, the server prompts for a server-key passphrase
# (≥16 characters) and stores it in the OS keychain for later boots. However,
# you can set the passphrase as an environment variable and the system won't
# prompt for the secret. Useful in HA scenarios where multiple replicas are
# deployed concurrently.
# export SERVER_KEY_PASSPHRASE=""
