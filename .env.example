# Database Configuration
export DB_HOST="localhost"
export DB_PORT="5432"
export DB_USER="syrinx"
export DB_PASSWORD="syrinx"
export DB_NAME="syrinx"
export DB_SSLMODE="disable"

# Server Configuration
export SERVER_NAME=""  # Your server name
export PORT=8080  # The port the backend will listen on
export ALLOWED_ORIGIN="http://localhost:5173"  # The URL of your frontend

# On first interactive start, the server prompts for a server-key passphrase
# (≥16 characters) and stores it in the OS keychain for later boots. However,
# you can set the passphrase as an environment variable and the system won't
# prompt for the secret. Useful in HA scenarios where multiple replicas are
# deployed concurrently.
# export SERVER_KEY_PASSPHRASE=""

# After ops import-identity, start the server with recovery mode so clients can
# rebuild the DB. Unset defaults to false. Accepted: true/false
# export RECOVERY_MODE="false"

# Signup policy: open | invite | closed (default: open).
# invite is accepted and exposed on /api/server/info; consume-at-signup lands later.
# export SIGNUP_MODE="open"

# Cap on invites each user may create (all-time, including used/revoked).
# Positive integer >= 1. To disable the cap: set to -1, or leave unset.
export MAX_INVITES_PER_USER="3"

# Local OTLP collector for request/DB tracing (see specs/observability/).
# Leave unset to keep observability disabled — no setup cost, no warnings.
# export OTEL_COLLECTOR_HOST="127.0.0.1"
# export OTEL_COLLECTOR_PORT="4317"

# Host identity for the telemetry this process emits. host.name is auto-detected,
# but on multiple hosts (or containers that resolve to the same hostname) set a
# distinct value here so streams don't collide into one series in OpenObserve.
# Standard OTEL var; comma-separated key=value pairs.
# export OTEL_RESOURCE_ATTRIBUTES="host.name=syrinx-01"
