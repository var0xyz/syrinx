# Database Configuration
export DB_HOST=localhost
export DB_PORT=5432
export DB_USER=syrinx
export DB_PASSWORD=syrinx
export DB_NAME=syrinx
export DB_SSLMODE=disable
export POSTGRES_PASSWORD="syrinx"

# Docker Compose Configuration
export POSTGRES_PASSWORD=$DB_PASSWORD

# Server Configuration
export PORT=8080
export CORS_ORIGIN="http://localhost:8080"
export SECURE_COOKIES="false"
export SERVER_IDENTITY_NAME=""
export SERVER_IDENTITY_EMAIL=""
export SERVER_PRIVATE_KEY_FILE="./keys/private.pgp"
export SERVER_PRIVATE_KEY_PASSPHRASE="set-this-to-your-private-key-passphrase"

# Observability Configuration
export OTLP_ENABLED="false"
export COLLECTOR_HOST="localhost"
export COLLECTOR_PORT="4318"
export SIGNOZ_JWT_SECRET=""
export SERVICE_NAME="syrinx-api"
export INSECURE_MODE="true"

# Session Secret Key (change this in production)
export SESSION_SECRET_KEY=your-super-secret-session-key-change-this-in-production

# SigNoz Configuration (no authentication required for OTLP endpoints)
# SigNoz UI will be available at http://localhost:3301
